{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/market", "destination": "/public/market.html" },
    { "source": "/auth", "destination": "/public/auth.html" },
    { "source": "/vault", "destination": "/public/vault.html" },
    { "source": "/certificate", "destination": "/public/certificate.html" },
    { "source": "/admin", "destination": "/public/admin/dashboard.html" }
  ]
}
